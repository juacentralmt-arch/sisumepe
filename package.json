{
  "name": "sistema-tornozeleiras",
  "version": "1.0.0",
  "description": "Gestão de atendimento e manutenção de tornozeleiras eletrônicas",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js && node --check store.js && node --check src/lib/shared.js && node --check src/routes/auth.js && node --check src/routes/admin.js && echo OK",
    "backup": "node -e \"require('./store').backup().then(b=>require('fs').writeFileSync('backup-'+new Date().toISOString().slice(0,10)+'.json',JSON.stringify(b)))\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.44.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^181.0.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174"
  }
}
