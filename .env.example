# Variáveis de ambiente (Render -> Environment)
# Sem elas, o sistema roda em modo arquivo local (db.json).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-service-role-key-aqui
PORT=3000
# Expiração dos anexos de tickets fechados (horas). Padrão: 24.
FILES_TTL_HOURS=24
# Google Agenda (opcional) - crie em https://console.cloud.google.com -> APIs e Serviços -> Credenciais -> OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-app.onrender.com/api/auth/google/callback
# Calendly (opcional, módulo Agenda de andre/daniel/admin) - https://calendly.com -> Integrations -> API & Webhooks -> Personal Access Token
# Escopos mínimos do token: event_types:read, scheduled_events:read
CALENDLY_TOKEN=
# Link público de agendamento (exibido na Agenda, ex: https://calendly.com/sua-equipe)
CALENDLY_URL=
