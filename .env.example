# Variáveis de ambiente (Render -> Environment)
# Sem elas, o sistema roda em modo arquivo local (db.json).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-service-role-key-aqui
PORT=3000
# Expiração dos anexos de tickets fechados (horas). Padrão: 24.
FILES_TTL_HOURS=24
# Google Agenda (opcional) - crie em https://console.cloud.google.com -> APIs e Serviços -> Credenciais -> OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-app.onrender.com/api/auth/google/callback
# IA - Interpretação semântica de Ativações (opcional). Defina UM dos provedores:
# OpenAI-compatível (recomendado): OPENAI_API_KEY + OPENAI_MODEL (ex: gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Alternativas: ANTHROPIC_API_KEY + ANTHROPIC_MODEL, ou GOOGLE_API_KEY + GEMINI_MODEL
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# LLM_MODEL=gpt-4o-mini
