# Variáveis de ambiente (Render -> Environment)
# Sem elas, o sistema roda em modo arquivo local (db.json).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-service-role-key-aqui
PORT=3000
# Expiração dos anexos de tickets fechados (horas). Padrão: 24.
FILES_TTL_HOURS=24
# Google Agenda + Drive (opcional) - crie em https://console.cloud.google.com -> APIs e Serviços -> Credenciais -> OAuth 2.0 (ative Calendar API e Drive API; redirect autorizado: <seu-app>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-app.onrender.com/api/auth/google/callback
# Arquivos compartilhados: login dono da conta única conectada + id da pasta do Drive
GOOGLE_DRIVE_USER=admin
GOOGLE_DRIVE_FOLDER_ID=1BBLOtCz9vxswiDPMQ-fwTuXqn8nxiM2M
# Calendly (opcional, módulo Agenda — todos, exceto recepção) - https://calendly.com -> Integrations -> API & Webhooks -> Personal Access Token
# Escopos mínimos do token: event_types:read, scheduled_events:read
CALENDLY_TOKEN=
# Link público de agendamento (exibido na Agenda, ex: https://calendly.com/sua-equipe)
CALENDLY_URL=
